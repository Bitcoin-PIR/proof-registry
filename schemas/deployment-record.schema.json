{
  "$id": "https://github.com/Bitcoin-PIR/proof-registry/schemas/deployment-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundleManifestSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "consumer": {
      "additionalProperties": false,
      "properties": {
        "commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "repository": { "pattern": "^https://github\\.com/Bitcoin-PIR/[A-Za-z0-9._-]+$", "type": "string" }
      },
      "required": ["repository", "commit"],
      "type": "object"
    },
    "createdAt": { "format": "date-time", "type": "string" },
    "deployment": {
      "additionalProperties": false,
      "properties": {
        "identifier": { "minLength": 1, "type": "string" },
        "kind": { "pattern": "^[a-z0-9][a-z0-9._-]*$", "type": "string" }
      },
      "required": ["kind", "identifier"],
      "type": "object"
    },
    "environment": { "pattern": "^[a-z0-9][a-z0-9._-]*$", "type": "string" },
    "mediaType": {
      "const": "application/vnd.bitcoinpir.deployment-record.v1+json"
    },
    "runtimePins": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": { "pattern": "^[a-z0-9][a-z0-9._-]*$", "type": "string" },
          "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
        },
        "required": ["name", "sha256"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": { "const": 1 },
    "verificationRecordSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
  },
  "required": [
    "schemaVersion",
    "mediaType",
    "createdAt",
    "environment",
    "deployment",
    "bundleManifestSha256",
    "verificationRecordSha256",
    "consumer",
    "runtimePins"
  ],
  "title": "Bitcoin-PIR deployment record v1",
  "type": "object"
}
